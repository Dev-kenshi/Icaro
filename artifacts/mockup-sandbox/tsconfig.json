{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "mockupPreviewPlugin.ts", "vite.config.ts"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noEmit": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/*": ["./src/components/mockups/icaro-app-current/_shared/lib/*"],
      "@/hooks/*": ["./src/components/mockups/icaro-app-current/_shared/hooks/*"],
      "@/hooks/use-mobile": ["./src/hooks/use-mobile.tsx"],
      "@/hooks/use-toast": ["./src/hooks/use-toast.ts"],
      "@/components/stage/*": ["./src/components/mockups/icaro-app-current/_shared/stage/*"],
      "@/components/login/login-gate": ["./src/components/mockups/icaro-app-current/_shared/login-gate.tsx"]
    }
  }
}
