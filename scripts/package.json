    "validate:auth": "tsx ./src/validate-auth.ts",
    "validate:routing": "tsx ./src/validate-routing.ts",
    "validate:stats": "tsx ./src/validate-stats.ts",
    "validate:pipeline": "tsx ./src/validate-voice-pipeline.ts",
    "validate:conhecimento": "tsx ./src/validate-conhecimento.ts",
