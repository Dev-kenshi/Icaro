modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "voice"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hologram"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "wake"

[[workflows.workflow]]
name = "voice"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run validate:voice"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "hologram"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run validate:hologram"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "wake"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts exec tsx ./src/validate-wake.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ICARO_ADMIN_CODE = "539426"
ICARO_USER1_CODE = "54632"
ELEVENLABS_VOICE_ID = "A26KfvFuSKaMzhhYkSlQ"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 25428
externalPort = 80
